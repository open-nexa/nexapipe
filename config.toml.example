# Nexapipe configuration example
#
# Usage:
#   cp config.toml.example config.toml     # config.toml is gitignored: it is the operator's live config
#   cargo run -p nexapipe -- --config config.toml
#
# This is the general example, with 2FA off. See config.toml.2fa.example for the
# same file with TOTP authentication enabled.
#
# Reloading: the file is re-read every 5 seconds. `[[routes]]` is applied live;
# a config that fails to parse or validate is reported and ignored, so a
# half-saved edit cannot take the proxy down. `[auth]` and `[auth.clients]` are
# applied live too — see the `[auth]` section below for what that does and does
# not cover. The rest is read once at startup and needs a restart: `[server]`,
# `[iroh]`, `[log]`.
#
# Every key is optional. What follows is "what it looks like when you use it",
# not a minimal config.

# ============================================================
# Top level
# ============================================================

# Removed: `default_backend` no longer exists, and a config that still names it
# is refused at startup rather than silently ignored. A host with no
# `mode = "http"` route is answered 404; "send everything here" is spelled as a
# catch-all route, which is also load-balanced and health-checked:
#
#   [[routes]]
#   host_pattern = "*"
#   mode = "http"
#   backends = ["http://127.0.0.1:18080"]
#
# `passthrough`, `tcp` and `udp` lookups never had a fallback and still have
# none - they refuse instead.

# Debug logging.
debug = false

# ============================================================
# [server] - direct plaintext ingress (off by default)
# ============================================================

[server]
# Left unset = the listener is never bound, and that is the default.
#
# Nothing on this listener is authenticated: the 2FA handshake runs in the iroh
# accept loop, so a request arriving here reaches a route without ever being
# asked for a credential. Use it only for something on the same host (a sidecar,
# a container sharing the network namespace), and keep it on 127.0.0.1.
# listen_addr = "127.0.0.1:8080"

# Allows listen_addr to name a non-loopback address (e.g. 0.0.0.0:8080).
# Turning it on publishes every `http` route and every `passthrough` backend to
# anyone who can reach the port, with no authentication in between. Enable it
# only when something downstream does the gating (reverse proxy, firewall,
# private network). Combined with `[auth] enabled = true` it is refused at
# startup.
expose = false

# Removed keys, still accepted so an old config.toml keeps parsing:
# tls_enabled / tls_listen_addr / cert_path / key_path. TLS is terminated by the
# backend now; this process holds no certificate.

# ============================================================
# [iroh] - the QUIC tunnel endpoint
# ============================================================

[iroh]
# A fixed endpoint identity: with it, the Node ID survives a restart. Generate
# one with `nexapipe --generate-secret`. Clients that fill in `server_node_id`
# need it, otherwise they lose track of the server every time it restarts.
# secret_key = "your-hex-encoded-secret-key"

# Fixed UDP port; unset means an ephemeral one.
bind_port = 0

# Relay mode: pinned / default / disabled / custom. Unset means default.
#   default  - every N0 relay, home relay chosen by latency; it can migrate
#              between relays, which drops the connections routed through it
#   pinned   - one fixed N0 relay (Singapore). Use when relay migration is
#              worse than a slightly slower relay
#   disabled - no relay transport at all. Note this also means you cannot dial
#              a peer through *its* relay
#   custom   - one relay you run, and only that one; no N0 relay is used
relay_mode = "default"

# Only used when relay_mode = "custom"; setting relay_url without a relay_mode
# means custom. Pointing it at *.relay.n0.iroh.link is rejected (use pinned or
# default for those).
# relay_url = "https://relay.example.com"

# Bearer token for a self-hosted relay that requires one. Only meaningful for
# custom, and both sides need it.
# relay_auth_token = ""

# ============================================================
# [log] - logging and rotation
# ============================================================

[log]
# Write log files. Default true.
file = true
# Log directory, default ./logs; NEXAPIPE_LOG_DIR overrides it.
dir = "./logs"
# Current log file name, default nexapipe.log; rotated copies are
# nexapipe.<timestamp>.log.
file_name = "nexapipe.log"
# One line per proxied request. Default true.
access_log = true
access_log_file_name = "access.log"
# Rotation period: daily (default) / hourly / never
rotation = "daily"
# Rotate above this size (MiB) as well; 0 = off. Default 0.
max_size_mb = 0
# Rotated files to keep; 0 = keep all. Default 14.
max_files = 14
# Also write to stdout. Default true.
console = true
# Replace query-string values with <redacted> in the access log, keeping the
# names. Default true.
#   /api/items?token=hunter2&page=2 -> /api/items?token=<redacted>&page=<redacted>
# Tokens, signatures and one-time codes travel in query values, and a log file
# gets rotated, archived and handed around - so values are dropped and the names
# that make the line worth reading stay. Set false to log URIs verbatim.
redact_query = true

# ============================================================
# [[routes]] - routing
# ============================================================

# 1) Plain HTTP: parse the request, apply path_pattern / path_rewrite, re-issue
#    it with the shared client. Backends must be http:// - an https:// backend
#    is rejected at startup (the backend terminates TLS; the hop to it is plain).
[[routes]]
host_pattern = "app.example.com"
path_pattern = "/"
path_is_prefix = true
strategy = "round_robin"          # or "random"
backends = ["http://127.0.0.1:18080", "http://127.0.0.2:18080"]
mode = "http"                     # the default; may be omitted
# path_rewrite = "/api"           # rewrite the path prefix before forwarding

# 2) passthrough: selected by SNI, bytes are copied verbatim, the backend
#    terminates TLS. The backend may be a bare host:port, and path_pattern /
#    path_rewrite do not apply.
[[routes]]
host_pattern = "web.example.com"
mode = "passthrough"
backends = ["127.0.0.1:443"]

# 3) tcp: carry a raw TCP flow to backends, selected by the host name in the L4
#    preface. client_ports is only a selector (it decides whether this route can
#    match); it never decides where the connection goes. Absent = every port
#    matches. Backends must spell out the port.
[[routes]]
host_pattern = "db.example.com"
mode = "tcp"
backends = ["127.0.0.1:5432"]
client_ports = [5432, 6432]

# 4) udp: UDP flows, one QUIC bi-stream per flow.
#    idle_timeout_secs = close the flow after this many silent seconds; unset
#    falls back to the server default.
[[routes]]
host_pattern = "turn.example.com"
mode = "udp"
backends = ["127.0.0.1:3478"]
idle_timeout_secs = 60

# 5) One host that has to answer both a request and a tunnel - the ordinary
#    shape for an Android TUN client: `modes` takes several, `mode` takes one.
#    They may be written together; the route serves the union, duplicates
#    collapse. The cost is that the address has to satisfy every declared mode,
#    and the L4 rules are stricter: the port must be written out. Give the modes
#    separate entries when they need different backends - a route has exactly
#    one backend pool.
[[routes]]
host_pattern = "vpn.example.com"
modes = ["passthrough", "tcp"]
backends = ["127.0.0.1:443"]

# ============================================================
# [health_check] - probing http backends
# ============================================================
# Every `mode = "http"` backend is asked `GET {backend}{path}` on a timer and
# leaves the pool after `threshold` consecutive failures. `passthrough`, `tcp`
# and `udp` routes are never probed: they cannot answer an HTTP request, and a
# failed probe would only take a healthy backend out of rotation.
#
# Set `enabled = false` when your backends cannot answer a probe on `{path}` -
# one that replies 5xx to an unknown path, or one that does not speak HTTP at
# all and so times out. A backend that answers 404 is already counted healthy,
# and so is any 2xx: a missing health endpoint is not on its own a reason to
# turn the checks off.
# Everything then stays in the pool and traffic is simply forwarded.
[health_check]
enabled = true
interval = 10
timeout = 5
threshold = 3
path = "/health"

# ============================================================
# [admin] - the auxiliary listener (off by default)
# ============================================================
# A second, loopback-only listener that answers questions about this instance
# instead of forwarding traffic:
#   GET /healthz  -> 200 "ok" for as long as the process is serving
#   GET /metrics  -> instance metrics in Prometheus text format
#                    (only while [metrics] enabled = true below)
#
# Absent means the listener is not bound at all, which is the default: an
# instance nobody scrapes or supervises should not hold a port open.
#
# Loopback only, and there is no `expose` escape hatch: nothing here
# authenticates, and the answer names your routes, clients and backends. Reach
# it from another host with an SSH tunnel, not with a bind address.
#
# `listen_addr` is NOT hot-reloadable - moving a listener is a restart.
# [admin]
# listen_addr = "127.0.0.1:9090"

# ============================================================
# [metrics] - whether /metrics is served
# ============================================================
# Off by default, because the listener it hangs off is unauthenticated: nothing
# is exposed until you ask for it here AND bind an [admin] address. Turning
# this on without an [admin] section logs a warning and serves nothing.
[metrics]
enabled = false

# ============================================================
# [local_proxy] - client mode (delete the section on a server)
# ============================================================

[local_proxy]
enabled = false
listen_addr = "127.0.0.1:8081"
# Domains to tunnel; --generate-invite without --invite-domains takes its
# domains from here too.
proxy_domains = ["app.example.com", "web.example.com"]
strategy = "round_robin"

# Preferred form: several server nodes. The same domain may appear on more than
# one node - that is how you load balance across servers. Replace the Node ID
# with the one the server prints (64 hex chars).
[[local_proxy.nodes]]
server_node_id = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
domains = ["app.example.com"]

# A full ticket (Node ID + addresses) works too: it changes whenever the
# addresses do, but it carries the complete connection information.
# [[local_proxy.nodes]]
# server_ticket = "nodeabc...#addresses"
# domains = ["web.example.com"]

# Deprecated single-node keys, still honoured: server_ticket / server_node_id.
# Prefer [[local_proxy.nodes]].
# server_node_id = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# server_ticket  = "full ticket"

# Client 2FA credentials: must match a client listed under [auth.clients] on the
# server, otherwise every connection is rejected. See config.toml.2fa.example.
# [local_proxy.two_factor]
# enabled = true
# client_id = "client-001"
# secret = "JBSWY3DPEHPK3PXP"
# algorithm = "sha1"

# ============================================================
# [peers] - which client Node IDs may connect at all (optional)
# ============================================================
# An allow-list of client public keys, checked during the QUIC handshake: a peer
# that is not on it is closed before any stream is opened or any slot is taken.
# With no [peers] section, every Node ID that can reach the endpoint proceeds to
# the next check - which, with [auth] off too, means the Node ID alone reaches
# every route. This is not a substitute for 2FA: it answers "may this Node ID be
# here", where 2FA answers "who is it". Use both when you can.
#
# Take each Node ID from the client app that owns it: this list names clients,
# and the Node ID in the server's own startup log is the server's - putting it
# here allows nobody. A typo is a startup error rather than a silently skipped
# entry, and an empty list is refused outright - it would lock you out of your
# own server.
#
# [peers]
# allow = [
#   "a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2",
# ]

# ============================================================
# [auth] - server-side 2FA (off by default)
# ============================================================
# With this on, every client connection must complete a TOTP handshake before
# proxying is allowed. The secrets below are the only credential gating the iroh
# listener, so keep the file private: with enabled = true the server refuses to
# start when config.toml is readable or writable by another account - chmod 600.
#
# Generate a secret and its enrollment QR code (both write the result back into
# config.toml, so do not point them at the example file itself):
#   nexapipe --generate-2fa client-001 --config config.toml
#   nexapipe --generate-invite client-001 --config config.toml
#
# The invite above carries the secret in the clear, so the code itself is the
# credential. `--registration` swaps it for a one-time enrollment token:
#   nexapipe --generate-invite client-001 --registration --config config.toml
# That token lands in `pending_enrollment` here; the first device to scan it
# trades it for a fresh secret and the token is spent - see
# config.toml.2fa.example for the full flow.
#
# [auth]
# enabled = true
# issuer = "NexaPipe"
# algorithm = "sha1"      # sha1 / sha256 / sha512
# time_step = 30
# digits = 6
# window = 1
# max_attempts = 5
# lockout_duration = 300
#
# [auth.clients.client-001]
# secret = "JBSWY3DPEHPK3PXP"
# created_at = "1723756800"
# allow_hosts = ["app.example.com", "*.db.example.com"]   # unset = every route
