<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Brings the tunnel back after the machine is restarted. The broadcast
         that asks for it is a protected one, so no other app can send it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Needed only to scan a 2FA provisioning QR code, so the app stays
         installable on devices without a camera and no permission is requested
         until the user opens the scanner. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".NexaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nexa"
        tools:targetApi="31">

        <!--
            Backup is on, and what it carries is worth saying out loud rather
            than leaving to be read out of the file names.

            **The credentials are not in it.** The seeds, the enrollment
            tokens and the device key live in `NexaPipeSecrets.xml`, and both
            rule files exclude that one file. So does the name this install
            answers as (`device_id`): a configuration restored onto another
            phone must not turn up claiming to be the one it was copied from,
            and it does not — the restored phone is a new device that has to
            be enrolled again.

            **What is in it is the configuration**: which endpoints this user
            set up, the UI language, and a few choices they made. That is
            what a backup is for.

            The arrangement rests on one rule, and it is the rule the next
            change has to keep: **a credential goes in `NexaPipeSecrets.xml`
            and nowhere else.** A key written into the file named in
            `backup_rules.xml` would ride along in the backup, and nothing
            would say so.
        -->

        <service
            android:name=".vpn.NexaVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="specialUse">

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />

            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Nexa">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Brings the tunnel back after the machine is restarted, when the
             user has asked for that. Exported because a receiver of a system
             broadcast has to be, and safe because BOOT_COMPLETED is a
             protected broadcast: no other app can send one. -->
        <receiver
            android:name=".vpn.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>