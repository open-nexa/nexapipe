target

# Working branches are checked out inside the repository, under .worktrees/.
# Each one is a separate git repository, so the parent must not track it.
.worktrees

# run_android.ps1 logcat capture (same name is already ignored inside ui-android/)
nexa_vpn_log.txt

# Runtime log files written by the [log] section of config.toml. The directory
# itself stays tracked so the docker-compose bind mount does not create it as
# root on the host.
logs/*
!logs/.gitkeep
config.toml
# The runtime state the server keeps beside the configuration: the 2FA
# counters, written by the server and by nobody else. It is the same kind of
# file as the configuration above — one machine's runtime, not the repository's.
state.toml
# The endpoint identity key the docker setup generates into ./secrets/iroh.key
# (NEXAPIPE_IROH_SECRET_KEY_FILE). The directory itself stays untracked the
# same way config/ is: a private key has no business in the repo.
secrets/
docs/*plan*
docs/*fix*
docs/*patch*
docs/*review*
docs/*research*
.DS_Store
crates/nexapipe/logs
