#!/bin/sh
# Remove the optional service when the package is removed. Do not touch it on upgrades.
set -e

SERVICE=nexa-service.service

case "${1:-}" in
    remove)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop "$SERVICE" || true
            systemctl disable "$SERVICE" || true
            rm -f "/etc/systemd/system/$SERVICE"
            # The service's own copy of the binary goes with the unit that ran it: a
            # service that is no longer installed has no binary to run, and a copy left
            # behind is one nothing will ever replace.
            rm -f /usr/libexec/nexa-service
            systemctl daemon-reload || true
        fi
        ;;
esac

exit 0
