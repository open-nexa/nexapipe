{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nexa",
  "version": "0.3.0",
  "identifier": "com.nexa.ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "nexa",
        "width": 1000,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "resources": [
      "wintun/bin/amd64/wintun.dll"
    ],
    "icon": [
      "icons/nexapipe.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/open-nexa/nexapipe/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4ODVFRjQ0NjlFOEY2NTIKUldSUzl1aHBSTytGbUxUcENoSkdjVHcvVHJWelBYVURqelRZeklNSTJNRFF1TGpmQ2dMUUl2MGMK",
      "dialog": true
    }
  }
}
