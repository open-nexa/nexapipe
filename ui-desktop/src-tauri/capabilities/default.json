{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "os:default",
    "updater:default",
    "clipboard-manager:allow-write-text",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-theme",
    "core:window:allow-show",
    "allow-accept-invite",
    "allow-clear-credentials",
    "allow-clear-logs",
    "allow-close-flow",
    "allow-close-node-flows",
    "allow-credential-display",
    "allow-credential-store-status",
    "allow-delete-credential",
    "allow-finish-quit",
    "allow-gate-status",
    "allow-get-active-flows",
    "allow-get-endpoint-links",
    "allow-get-logs",
    "allow-get-node-health",
    "allow-get-node-id-display",
    "allow-get-node-traffic",
    "allow-get-proxy-status",
    "allow-get-service-status",
    "allow-get-service-version",
    "allow-get-startup-error",
    "allow-install-service",
    "allow-is-service-running",
    "allow-lock-credentials",
    "allow-parse-invite",
    "allow-put-credential",
    "allow-reveal-credential",
    "allow-reveal-node-id",
    "allow-start-proxy",
    "allow-start-service",
    "allow-stop-proxy",
    "allow-stop-service",
    "allow-take-invited-node-credentials",
    "allow-take-issued-credential",
    "allow-take-runtime-credentials",
    "allow-uninstall-service",
    "allow-unlock-credentials"
  ]
}
