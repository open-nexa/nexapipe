# Not built by CI, and not exercised by any workflow: release.yml builds the
# arm64 image from the plain Dockerfile on an arm64 runner. This file is kept
# for a manual cross-build from an amd64 host, so its two base-image digests
# are not verified on every run.
#
# Pinned by digest, not by tag: see the note in the Dockerfile. This is
# rust:1.98-alpine, the 1.98.1-alpine3.24 image.
FROM rust:1.98-alpine@sha256:7cc1c22d77d9432f7fe012a70e6d3e555af54c2a6832700ed7d553f1769ae89f AS builder

RUN apk add --no-cache musl-dev gcc make cmake ninja perl coreutils aarch64-linux-musl-gcc
RUN rustup target add aarch64-unknown-linux-musl

ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=aarch64-linux-musl-gcc
ENV CC_aarch64_unknown_linux_musl=aarch64-linux-musl-gcc

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
# `[patch.crates-io]` points at the vendored smoltcp fork, so it has to be in
# the build context as well.
COPY third_party ./third_party

# The client crate lists both `lib` and `cdylib` as its crate types, and cargo builds the
# cdylib slot even when the client is only a dependency here. musl turns crt-static on by
# default, which leaves rustc unable to produce one, so expect this and move on:
#   warning: dropping unsupported crate type `cdylib` for target `aarch64-unknown-linux-musl`
# The binary links the rlib, which is built either way; nothing is missing.
#
# --locked, for the reason the Dockerfile gives.
RUN cargo build --release --locked --target=aarch64-unknown-linux-musl -p nexapipe

# The runtime image comes from a mirror, because a hosted runner has no route
# to Docker Hub from where this is built. The digest is the content digest of
# alpine:3.24 upstream: a pull-through cache serves the manifest it fetched,
# byte for byte, so the digest is the same on both sides — and if the mirror
# ever serves something else, the build fails with "manifest unknown" rather
# than quietly building against an image nobody pinned.
FROM registry.it.iakl.top/alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

RUN apk add --no-cache ca-certificates tzdata

# The proxy needs no privileges, and running it as root bought nothing: the
# plaintext listener is off by default, the TLS port belongs to the backend
# (Caddy), and the iroh port is an ephemeral UDP one. uid 1000 matches what the
# bind mounts are usually owned by; see the amd64 Dockerfile for the upgrade
# note, which applies here unchanged.
RUN adduser -D -u 1000 -h /app nexapipe

WORKDIR /app

# Default location of the log files; docker-compose mounts a volume on top.
RUN mkdir -p /app/logs

# Where docker-compose mounts the config directory.
RUN mkdir -p /app/config

# Where the endpoint identity lives, kept out of config.toml since v0.6.1:
# [iroh] secret_key_file points at /app/secrets/iroh.key and the first start
# generates the key into it. The amd64 image has created this since the same
# release; without it an arm64 deployment has nowhere to put the key.
RUN mkdir -p /app/secrets

COPY --from=builder /app/target/aarch64-unknown-linux-musl/release/nexapipe /usr/local/bin/nexapipe

# Owned by the runtime user, because all three are bind-mounted on top at run
# time and what matters is the host directory's ownership — this only makes an
# un-mounted `docker run` work.
RUN chown -R nexapipe:nexapipe /app/logs /app/config /app/secrets

# The proxy listens for HTTP (and TLS passthrough) on [server] listen_addr and
# for iroh on a UDP port. The TLS port belongs to the backend (Caddy), which this
# container only connects out to.
EXPOSE 8080

# config.toml is **not** copied in either: it holds the 2FA secrets under
# [auth.clients]. It is mounted at run time (see docker-compose.yaml), as the
# directory /app/config — a single-file bind mount is pinned to one inode and
# stops following the file as soon as anything replaces it.

USER nexapipe

ENTRYPOINT ["nexapipe"]
CMD ["--config", "/app/config/config.toml"]
